{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "simple-coding",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "env": { "BROWSER": "none" },
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "debugWithChrome",
        "pattern": "Local server running at (https?://localhost:[0-9]+)",
        "uriFormat": "%s/index.html#saved-games?mock=sample",
        "webRoot": "${workspaceFolder}/src"
      }
    },
    {
      "name": "simple-coding (Edge)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "env": { "BROWSER": "none" },
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "debugWithEdge",
        "pattern": "Local server running at (https?://localhost:[0-9]+)",
        "uriFormat": "%s/index.html#saved-games?mock=sample",
        "webRoot": "${workspaceFolder}/src"
      }
    },
    {
      "name": "Live capture",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "env": { "BROWSER": "none" },
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "debugWithChrome",
        "pattern": "Local server running at (https?://localhost:[0-9]+)",
        "uriFormat": "%s/index.html#event-capture?mock=active",
        "webRoot": "${workspaceFolder}/src"
      }
    },
    {
      "name": "Match review",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "env": { "BROWSER": "none" },
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "debugWithChrome",
        "pattern": "Local server running at (https?://localhost:[0-9]+)",
        "uriFormat": "%s/timeline-video.html?game=sample-game",
        "webRoot": "${workspaceFolder}/src"
      }
    },
    {
      "name": "Jest: current file",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
      "args": ["${relativeFile}", "--runInBand"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
