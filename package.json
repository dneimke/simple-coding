{
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/serve.js",
    "serve": "node scripts/serve.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "test:visual": "node scripts/visual-snapshot.js",
    "audit": "fallow audit --base origin/main",
    "audit:all": "fallow",
    "audit:dead-code": "fallow dead-code",
    "guardrails": "npm run typecheck && npm run audit",
    "typecheck": "tsc -p jsconfig.json"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.9",
    "fallow": "^3.38.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
